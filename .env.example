# =============================================================================
# Walk2AI — environment configuration template
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# This file holds INFRASTRUCTURE and SECRETS only. Business parameters (reward
# rates, daily cap, model prices, exchange rates, spending limits) are versioned
# rows in the database, managed through the admin API — not environment values.
#
# To start, only two values are required: POSTGRES_PASSWORD and JWT_SECRET.
# Generate each with any of:
#     openssl rand -hex 32
#     docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# The timezone that defines a user's "day": the daily reward cap resets at local
# midnight here, daylight saving included. New accounts start with this value.
DEFAULT_TIMEZONE=Europe/Lisbon

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=walk2ai
POSTGRES_PASSWORD=
POSTGRES_DB=walk2ai
# Used when the backend runs directly on your machine. Under docker compose the
# backend always reaches the database at "db:5432" regardless of these two.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: a full URL instead of the values above (e.g. a managed database).
# Must use the psycopg driver.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/walk2ai

# --- Authentication ----------------------------------------------------------
# At least 32 characters. Signs access tokens and keys pairing-code hashes.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (cookies sent over HTTPS only).
COOKIE_SECURE=false
# first_user_only | open | closed
# first_user_only: the first account becomes the admin, then registration closes.
REGISTRATION_MODE=first_user_only

# --- AI providers (backend only — never expose to the frontend or the app) ----
# Use keys created in a dedicated Walk2AI project/workspace with a small prepaid balance
# and auto-recharge off. An empty key means that provider's models are unavailable.
# Setting a key does not spend anything by itself: a model must still be checked and
# enabled by the administrator, and every request is paid for with Walk Credits.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=120
# Answer length: default and maximum output tokens per request.
AI_DEFAULT_MAX_OUTPUT_TOKENS=2048
AI_MAX_OUTPUT_TOKENS=8192
# How many earlier messages of a conversation are sent with each new one.
AI_HISTORY_MESSAGES=20

# --- Fitness -----------------------------------------------------------------
# Allows clearly-labelled TEST activity through POST /fitness/sync/test, so the
# reward engine can be tried without a device. Must be false in production.
ALLOW_TEST_FITNESS_DATA=false
# How many days back late-arriving activity can still earn credits.
REWARD_WINDOW_DAYS=7
# How many days back activity is accepted at all (older records are rejected).
SYNC_WINDOW_DAYS=30
# Plausibility bounds: records beyond these are rejected, never stored.
MAX_STEPS_PER_DAY=100000
MAX_WORKOUT_HOURS=12

# --- Web ---------------------------------------------------------------------
# Origin the browser uses to reach Walk2AI; state-changing requests from any other
# origin are rejected. Until the web app exists (Phase 4) that is the backend's own
# interactive documentation at http://localhost:8000. If you change BACKEND_PORT,
# change the port here too.
PUBLIC_ORIGIN=http://localhost:8000
# Host port the backend API is published on by docker compose.
BACKEND_PORT=8000
