# =============================================================================
# Walk2AI — environment configuration template
#
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# This file holds INFRASTRUCTURE and SECRETS only. Business parameters (reward
# rates, daily cap, model prices, exchange rates, spending limits) are versioned
# rows in the database, managed through the admin API — not environment values.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=walk2ai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=walk2ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLAlchemy URL used by the backend and Alembic (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://walk2ai:change-me-locally@localhost:5432/walk2ai

# --- Authentication ----------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (cookies sent over HTTPS only).
COOKIE_SECURE=false
# first_user_only | invite | open
# first_user_only: the first account becomes the admin, then registration closes.
REGISTRATION_MODE=first_user_only

# --- AI providers (backend only — never expose to the frontend or the app) ----
# Use keys scoped to a dedicated Walk2AI project/workspace with a spend limit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Fitness -----------------------------------------------------------------
# Allows clearly-labelled test fitness data (Phase 2). Must be false in production.
ALLOW_TEST_FITNESS_DATA=false
# How many days back late-arriving activity can still earn credits.
REWARD_WINDOW_DAYS=7

# --- Web ---------------------------------------------------------------------
# Public origin of the web app; used for CORS/CSRF checks and cookie scope.
PUBLIC_ORIGIN=http://localhost:3000
# Where the Next.js dev server proxies /api to.
BACKEND_INTERNAL_URL=http://localhost:8000
